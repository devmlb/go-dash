{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "GO Dash",
    "version": "0.6.0",
    "identifier": "fr.devmlb.godash",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "GO Dash",
                "width": 800,
                "height": 600,
                "minWidth": 800,
                "minHeight": 600,
                "backgroundColor": "#fcfcfc",
                "visible": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": true,
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    },
    "plugins": {
        "updater": {
            "active": true,
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3MDc3Mzg5MzRCOEZDNkMKUldScy9MZzBpWE1ISjRzUjh1bG5pOEhoZ2JmM2tuNlNaUFJoTThyU2RFN1VqS1dNVFBvZGhPSTIK",
            "endpoints": [
                "https://github.com/devmlb/go-dash/releases/latest/download/latest.json"
            ]
        }
    }
}
