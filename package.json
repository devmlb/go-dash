{
    "name": "go-dash",
    "private": true,
    "version": "0.6.2",
    "description": "A dashboard for your Grand Orgue organs",
    "author": "devmlb",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-dialog": "^2.8.4",
        "@tauri-apps/plugin-fs": "^2.7.1",
        "@tauri-apps/plugin-opener": "^2.7.2",
        "@tauri-apps/plugin-os": "^2.4.0",
        "@tauri-apps/plugin-store": "^2.5.0",
        "@tauri-apps/plugin-updater": "^2.14.1",
        "@tauri-apps/plugin-window-state": "^2.5.0",
        "autoprefixer": "^10.6.2",
        "i18next": "^26.7.2",
        "i18next-browser-languagedetector": "^8.3.0",
        "lucide-react": "^1.69.0",
        "postcss": "^8.5.32",
        "postcss-nesting": "^14.0.3",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.1.13",
        "react-markdown": "^10.1.0"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.12.4",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6"
    },
    "allowScripts": {
        "esbuild@0.28.1": true
    },
    "overrides": {
        "typescript-eslint": {
            "typescript": "$typescript"
        },
        "eslint-plugin-react": {
            "eslint": "$eslint"
        }
    }
}
